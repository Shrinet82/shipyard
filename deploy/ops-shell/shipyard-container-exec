#!/usr/bin/env python3
"""Run ONE allowlisted read-only diagnostic inside a Coolify application's container. Root-owned; reached only through sudo.

  sudo -n /usr/local/sbin/shipyard-container-exec <coolify application uuid> <command> [args...]

The forced-command wrapper calls this for the shipyard-ops key (sudoers lets that one account run exactly this file). We find the
container from the application's uuid (Coolify names it `<uuid>-<digits>`), resolve every path argument inside the container
(readlink -f) so a symlink cannot lead to a refused file, apply the same allowlist as the Gatekeeper, and run the command with
`docker exec` as an argument list: no shell, no tty, no stdin, a timeout and an output cap. Every call is logged to syslog.
"""
import os
import re
import subprocess
import sys
import syslog

sys.path.insert(0, "/usr/local/lib/shipyard-ops")
from shellrules import Refused, check_container  # noqa: E402

TIMEOUT = 20
MAX_OUT = 20000
ENV = {"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "LANG": "C"}


def docker(*args, timeout=TIMEOUT):
    return subprocess.run(["docker", *args], capture_output=True, text=True, timeout=timeout, shell=False, stdin=subprocess.DEVNULL, env=ENV)


def container_of(uuid):
    p = docker("ps", "--filter", f"name={uuid}", "--format", "{{.Names}}")
    names = sorted(n for n in p.stdout.split() if re.fullmatch(re.escape(uuid) + r"-\d+", n))
    return names[-1] if names else None


def main():
    syslog.openlog("shipyard-container-exec", 0, syslog.LOG_AUTH)
    who = os.environ.get("SUDO_USER", "")
    if who != "shipyard-ops" or len(sys.argv) < 3:
        syslog.syslog(syslog.LOG_WARNING, f"refused: called by {who!r} with {len(sys.argv) - 1} argument(s)")
        print("refused: this helper is for the shipyard-ops key only", file=sys.stderr)
        return 2
    uuid, argv = sys.argv[1], sys.argv[2:]
    try:
        if not re.fullmatch(r"[a-z0-9]{20,32}", uuid):
            raise Refused("that is not a Coolify application id")
        check_container(argv)
        name = container_of(uuid)
        if name is None:
            raise Refused("that application has no running container")

        def resolve(path):
            p = docker("exec", name, "readlink", "-f", path, timeout=10)
            return p.stdout.strip().splitlines()[0] if p.returncode == 0 and p.stdout.strip() else ""
        check_container(argv, resolve)
    except Refused as exc:
        syslog.syslog(syslog.LOG_WARNING, f"refused {uuid} {' '.join(argv)[:200]!r}: {exc}")
        print(f"refused: {exc}", file=sys.stderr)
        return 2
    syslog.syslog(syslog.LOG_INFO, f"run in {name}: {' '.join(argv)!r}")
    try:
        p = docker("exec", "--workdir", "/", name, *argv)
    except subprocess.TimeoutExpired:
        print(f"refused: the command ran longer than {TIMEOUT} s", file=sys.stderr)
        return 3
    sys.stdout.write((p.stdout + p.stderr)[:MAX_OUT])
    return p.returncode


if __name__ == "__main__":
    sys.exit(main())
